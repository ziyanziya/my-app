# Copy this file to .env and fill values
DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=elsirat_db
DB_CONNECTION_LIMIT=10
DB_BACKUP_DIR=backups
DB_BACKUP_RETENTION_DAYS=7

# JWT
JWT_SECRET=replace_me_with_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# SMTP (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

PORT=5002

# Comma-separated web origins for production, for example:
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
